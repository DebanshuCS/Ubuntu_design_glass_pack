settings-version=8

[appfolder]
pipeline='pipeline_migrated_dynamic_blur'
style-dialogs=3

[applications]
blacklist=['Plank', 'com.desktop.ding', 'Conky', 'com.rastersoft.ding', 'com.rastersoft.dingtest', 'com.rastersoft.ding*', 'com.desktop.ding*', 'gjs']
blur=true
blur-on-overview=false
corner-radius=10
corner-when-maximized=false
dynamic-opacity=false
enable-all=true
opacity=255
pipeline='pipeline_frosted_apps'
static-blur=false
unblur-when-fullscreen=true
whitelist=['org.gnome.*', 'gnome-control-center', 'Nautilus', 'com.mattjakeman.ExtensionManager', 'extension-manager', 'net.nokyan.Resources', 'resources', 'snap-store']

[coverflow-alt-tab]
pipeline='pipeline_default'

[dash-to-dock]
blur=true
corner-radius=15
override-background=true
pipeline='pipeline_f9e2bcbe-4adf-4021-9e8c-aa964e423b03'
static-blur=true
style-dash-to-dock=2
unblur-in-overview=false

[dash-to-panel]
blur-original-panel=true

[hidetopbar]
compatibility=false

[lockscreen]
blur=true
pipeline='pipeline_lockscreen_black_glass'

[overview]
blur=true
pipeline='pipeline_dark_overview'
style-components=2

[panel]
blur=true
corner-radius=0
force-light-text=true
match-theme-in-overview=true
override-background=true
override-background-dynamically=false
pipeline='pipeline_frosted_apps'
static-blur=false
style-panel=0
unblur-in-overview=true

[popup]
blur=true
corner-radius=18
dialog-corner-radius=18
menu-corner-radius=20
notification-corner-radius=18
osd-corner-radius=28
osk-corner-radius=0
override-background=true
pipeline='pipeline_migrated_dynamic_blur_4'
preserve-shell-theme=false
quick-settings-corner-radius=36
static-blur=false
style-popup=2

[screenshot]
pipeline='pipeline_default'
